{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      // React Native's own .d.ts files import each other through self-referential
      // `react-native/types/...` specifiers, which its `exports` map fails to
      // resolve for TypeScript. `skipLibCheck` hides the resulting TS2307s, but
      // the damage still lands: ViewProps and friends degrade to error types, so
      // every host component loses its React.Component members and fails as a JSX
      // element. Mapping the subpath straight to disk bypasses the broken map.
      "react-native/*": [
        "./node_modules/react-native/*"
      ],
      // Same defect one level down: this package's `exports` map sets
      // `"types": null` for every subpath, so its own
      // `export * from '@react-native/virtualized-lists/Lists/VirtualizedList'`
      // resolves to nothing and ListRenderItemInfo disappears, taking FlatList's
      // and SectionList's renderItem argument types with it.
      "@react-native/virtualized-lists/*": [
        "./node_modules/@react-native/virtualized-lists/*"
      ],
      // Dexie's `exports` map has no `types` condition, so TypeScript lands on
      // `import-wrapper.d.mts` — which re-exports from 'dexie', resolving back to
      // itself. Every named export is lost. Point at the real declaration file.
      "dexie": [
        "./node_modules/dexie/dist/dexie.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    // Naming `exclude` at all replaces TypeScript's default, so the defaults have to be
    // restated — otherwise `include: ["**/*.ts"]` would start compiling node_modules.
    "node_modules",
    "dist",
    // The relay worker is a separate deployment target with a different global environment
    // — Durable Objects, `WebSocketPair`, no React Native — and it carries its own
    // `server/tsconfig.json` and `npm run typecheck`. Compiling it against the app's config
    // would fail on globals that genuinely do not exist here.
    "server"
  ]
}
